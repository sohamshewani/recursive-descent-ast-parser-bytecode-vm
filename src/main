#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "include/parser.h"
#include "include/interpreter.h"
#include "include/bytecode.h"
#include "include/stack.h"
#include "include/error.h"

int main(int argc, char *argv[]) {
	if (argc != 2) {
		printf("Usage: %s <source_file>", argv[0]);
		return 1;
	}

	char *source_code = readFile(argv[1]);
	if (!source_code) {
		printf("Failed to read file.");
		return 1;
	}

	Node *ast = parse(source_code);
	if (!ast) {
		printf("Failed to parse source code.");
		return 1;
	}

	Bytecode *bytecode = generateBytecode(ast);
	if (!bytecode) {
		printf("Failed to generate bytecode.");
		return 1;
	}

	Stack *stack = createStack();
	if (!stack) {
		printf("Failed to create stack.");
		return 1;
	}

	interpret(bytecode, stack);

	destroyStack(stack);
	destroyBytecode(bytecode);
	destroyAST(ast);
	free(source_code);

	return 0;
}